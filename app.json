{
  "expo": {
    "name": "synapse-app",
    "slug": "synapse-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "synapseapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.the-wedge.synapse-app",
      "appleTeamId": "BK483NXCX5",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.dev.the-wedge.synapse-app",
          "group.dev.the-wedge.synapse-app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171A20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.thewedge.synapseapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 360,
          "resizeMode": "contain",
          "backgroundColor": "#171A20",
          "dark": {
            "backgroundColor": "#171A20"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E9EDF3",
          "defaultChannel": "default"
        }
      ],
      "./modules/speech-recognizer/plugin/withSpeechRecognizerPermissions",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "dev.the-wedge.synapse-app.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.the-wedge.synapse-app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "dev.the-wedge.synapse-app.watch.watchwidget",
                  "targetName": "watchwidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.the-wedge.synapse-app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "dev.the-wedge.synapse-app.watch",
                  "targetName": "watch",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.the-wedge.synapse-app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "dev.the-wedge.synapse-app.share",
                  "targetName": "share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.the-wedge.synapse-app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "431b3534-d4d1-4fce-ab9c-14af1613cad3"
      }
    }
  }
}
