{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openwork",
  "mcp": {
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    },
    "control-chrome": {
      "command": [
        "chrome-devtools-mcp"
      ],
      "type": "local"
    },
    "argent": {
      "type": "local",
      "command": [
        "argent",
        "mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "opencode-scheduler"
  ],
  "tools": {
    "argent*": true
  }
}