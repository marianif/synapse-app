{
  "name": "synapse-app",
  "main": "expo-router/entry",
  "version": "0.0.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean:ios": "rm -rf ~/Library/Developer/Xcode/DerivedData/ && npx expo prebuild -p ios --clean",
    "clean:pods": "pod deintegrate && pod cache clean --all && rm -rf Podfile.lock && pod install",
    "clean:prewidget": "rm -rf ~/Library/Developer/Xcode/DerivedData/ && npx expo prebuild -p ios --clean --template ./node_modules/@bacons/apple-targets/prebuild-blank.tgz",
    "prewidget": "EXPO_NO_GIT_STATUS=1 npx expo prebuild --template ./node_modules/@bacons/apple-targets/prebuild-blank.tgz --clean"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.6",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/host-grotesk": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/expo-apple-targets": "^0.1.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.12.0",
    "dayjs": "^1.11.20",
    "expo": "^55.0.11",
    "expo-constants": "~55.0.11",
    "expo-dev-client": "~55.0.22",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.11",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.10",
    "expo-splash-screen": "~55.0.15",
    "expo-sqlite": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "react-redux": "^9.3.0",
    "reicon-mcp": "^1.1.101",
    "reicon-react-native": "^1.0.0",
    "rn-emoji-keyboard": "^1.7.0",
    "watch-connectivity": "./modules/watch-connectivity",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
